# Development only: accounts and the cloud copy on the Firebase emulators of this computer.
# "demo-" projects never reach a real Firebase project. Start them with: npm run dev:cloud
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nsalek
NEXT_PUBLIC_FIREBASE_APP_ID=demo
NEXT_PUBLIC_FIREBASE_EMULATOR=1
# Development only: a fake Google Drive kept in this browser (never in a production build).
NEXT_PUBLIC_DRIVE_FAKE=1
