# Without the Firebase values below, Nsalek has no accounts and stays fully local.
# Nothing here is a secret. Never put credentials in NEXT_PUBLIC_* values:
# they are embedded in the public JavaScript bundle.

# Optional: brand override shown in the UI (placeholder brand, not trademark-cleared).
NEXT_PUBLIC_BRAND_NAME=Nsalek
NEXT_PUBLIC_BRAND_NAME_AR=نسالك

# Accounts and cloud copy: the web app's public identification in Nsalek's own Firebase project.
# Never the Agrovet clinic's project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Copy in the person's own Google Drive: the OAuth "Web application" client of the same Google
# Cloud project (public; Google checks the site address it is used from). Without it, no Drive copy.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
