# Nsalek runs fully local by default and needs no environment variables.
# Nothing here is a secret. Never put credentials in NEXT_PUBLIC_* values:
# they are embedded in the public JavaScript bundle.

# Optional: brand override shown in the UI (placeholder brand, not trademark-cleared).
NEXT_PUBLIC_BRAND_NAME=Nsalek
NEXT_PUBLIC_BRAND_NAME_AR=نسالك

# P2 (not implemented): cloud sync endpoint. Leave empty. The app never
# connects to the Agrovet clinic Firebase project.
NEXT_PUBLIC_SYNC_ENDPOINT=
