{
  "name": "nsalek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:cloud": "node scripts/with-emulators.mjs npm run dev",
    "build": "next build && node scripts/sw-precache.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:cloud": "node scripts/with-emulators.mjs node --test --test-reporter=spec tests/emulator/cloud.emu.ts",
    "bench": "node scripts/bench.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "firebase": "^12.19.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
